.page {
  min-height: 100vh;
  padding: 28rpx;
}

.hero {
  min-height: 340rpx;
  border-radius: 16rpx;
  padding: 38rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(23, 33, 27, 0.18), rgba(23, 33, 27, 0.86)),
    #315b47;
  box-shadow: 0 24rpx 70rpx rgba(20, 34, 26, 0.18);
}

.eyebrow,
.kicker,
.muted,
.note,
.metrics {
  color: #627069;
  font-size: 24rpx;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-weight: 700;
  text-transform: uppercase;
}

.title {
  margin-top: 10rpx;
  font-size: 72rpx;
  line-height: 0.98;
  font-weight: 900;
}

.subtitle {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 30rpx;
  line-height: 1.45;
}

.section {
  margin-top: 26rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(20, 34, 26, 0.1);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.kicker {
  margin-bottom: 8rpx;
  font-weight: 800;
  text-transform: uppercase;
}

.section-title {
  font-size: 34rpx;
  font-weight: 850;
}

.refresh {
  min-width: 108rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #17211b;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.forecast-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.forecast-row {
  display: flex;
  gap: 18rpx;
}

.forecast-card {
  width: 184rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.12);
  border-radius: 14rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.date {
  color: #17211b;
  font-size: 32rpx;
  font-weight: 850;
}

.icon {
  width: 72rpx;
  height: 72rpx;
  margin: 22rpx 0 12rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 184, 75, 0.18);
  font-size: 36rpx;
}

.summary {
  min-height: 64rpx;
  color: #627069;
  font-size: 26rpx;
  white-space: normal;
}

.temp {
  margin-top: 10rpx;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 850;
}

.condition {
  margin-top: 6rpx;
  color: #1f7a4d;
  font-size: 24rpx;
  font-weight: 800;
}

.week-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.day-row {
  padding: 20rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.12);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
}

.day-label {
  margin-bottom: 18rpx;
}

.court-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.court-button {
  min-height: 94rpx;
  margin: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.12);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  color: #17211b;
  text-align: left;
  line-height: 1.2;
}

.court-button::after {
  border: none;
}

.court-button.disabled {
  opacity: 0.62;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tbc {
  background: #1f7a4d;
}

.ubc {
  background: #2667a9;
}

.court-name {
  font-size: 30rpx;
  font-weight: 850;
}
